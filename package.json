{
  "name": "dsh-session-sticker-board",
  "version": "0.7.4-rc2.1",
  "private": false,
  "description": "Persistent ordinary stickers and note associations through the shared DSH Obsidian Bridge",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/types/remote/typert.d.ts",
      "default": "./lib/typert.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib",
    "src",
    "CHANGELOG.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/changes"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsdown --config-loader unrun --config tsdown.config.ts",
    "prepack": "pnpm build",
    "pretest": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm typecheck && pnpm test && pnpm pack --dry-run --json"
  },
  "dependencies": {
    "lucide-react": "0.542.0",
    "zod": "4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "dshKnowledge": {
    "annotationProtocolVersion": 2,
    "stickerProtocolVersion": 1,
    "bridgeLifecycleProtocolVersion": 3
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-profile",
      "dispose": "supported"
    },
    "permissions": [
      "network:loopback",
      "session:read",
      "session:write",
      "ui:modify"
    ],
    "capability": {
      "id": "session-sticker-board",
      "kind": "ui",
      "invocation": "select text in a DSH message and add a sticker",
      "expected": "the sticker is persisted and can open its Obsidian backlinks"
    },
    "evidence": {
      "install": "docs/release/verification.md",
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.2",
    "@deepseek-ai/schemastery": "*",
    "dsh-annotation-core": "^0.3.9 || 0.3.10-dev.2 || 0.3.11-rc2.1 || 0.3.11-rc2.2 || 0.3.12-rc2.1 || 0.3.12-rc2.2 || 0.3.12-rc2.3 || 0.3.12-rc2.4 || 0.3.12-rc2.5 || 0.3.12-rc2.6 || 0.3.12-rc2.7 || 0.3.12-rc2.8 || 0.3.12-rc2.9 || 0.3.12-rc2.10 || 0.3.12-rc2.11 || 0.3.12-rc2.12 || 0.3.12-rc2.19",
    "dsh-better-sidebar": "^0.18.0 || ^0.19.1 || 0.19.2-rc2compat.1",
    "dsh-obsidian-bridge-lifecycle": "^0.4.0-rc2.1",
    "dsh-obsidian-bridge-protocol": "^0.3.2 || 0.3.3-rc2.1",
    "react": "*",
    "react-dom": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "dsh-annotation-core": {
      "optional": true
    },
    "dsh-obsidian-bridge-lifecycle": {
      "optional": true
    },
    "dsh-obsidian-bridge-protocol": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.5-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@linmu/dsh-session-contracts": "file:../dsh-session-maintenance/packages/contracts",
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.3.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "dsh-annotation-core": "link:../dsh-annotation-core",
    "dsh-obsidian-bridge-lifecycle": "link:../dsh-obsidian-bridge-lifecycle",
    "dsh-obsidian-bridge-protocol": "file:.dev-packages/dsh-obsidian-bridge-protocol-0.3.3-rc2.1.tgz",
    "jsdom": "26.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.19.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/linmu115/dsh-session-sticker-board.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
